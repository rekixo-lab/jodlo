{
  // LOCAL ONLY. Placeholder UUID is not a Cloudflare resource: never deploy this config.
  "name": "jodlo-api-local",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-27",
  "workers_dev": false,
  "send_metrics": false,
  // Local simulations ONLY. Unique fake namespaces, NOT Cloudflare resources.
  // Approximate per-PoP limits; never interpret these as globally strict.
  "ratelimits": [
    { "name": "LOGIN_BURST_LIMITER", "namespace_id": "1001",
      "simple": { "limit": 100, "period": 10 } },
    { "name": "ACCOUNT_LOGIN_LIMITER", "namespace_id": "1002",
      "simple": { "limit": 20, "period": 60 } }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "jodlo_catalog_local",
      "database_id": "00000000-0000-0000-0000-000000000001",
      "migrations_dir": "../../infra/migrations"
    }
  ]
}
